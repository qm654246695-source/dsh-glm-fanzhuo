{
  "name": "glm-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把 H:\\GLM 里那位 GLM 装进 DSH 左边栏：一个图标，点开就能聊。宿主半只负责拉起她的本机服务并转发 /glm-panel/api/*，客户端半是侧边栏图标 + 聊天面板。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
